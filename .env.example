GROQ_API_KEY=your_groq_api_key_here

# Required for posting review comments back to PRs (and for higher API rate limit).
# Create at github.com/settings/tokens. Scopes: `repo` (private) or `public_repo` + write:discussion
GITHUB_TOKEN=ghp_your_token_here

# Required only if you wire up the GitHub webhook receiver (auto-review on every new PR).
# Generate a random secret (e.g. `openssl rand -hex 32`) and use the same value when configuring
# the webhook in your GitHub repo settings.
GITHUB_WEBHOOK_SECRET=your_random_hex_secret

# Concurrency throttle for the 5 reviewer agents.
# Default 1 (sequential) — safe for Groq free tier (12K TPM).
# Set to 5 on Groq Dev Tier or any paid plan for full parallelism.
REVIEW_CONCURRENCY=1
REVIEW_STAGGER_SECONDS=3
